# =============================================================================
# Sedge - AI Financial Copilot for Stablecoins
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- AI Intent Parser (Phase 2) ---
# Cysic GPT-5 API key. Obtain from Cysic's developer portal.
CYSIC_API_KEY=your_cysic_api_key_here

# --- RPC Endpoints (Phase 1) ---
# Arc Testnet (chain ID 5042002). Public fallback: https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# Ethereum Sepolia (chain ID 11155111). Public fallback: https://rpc.sepolia.org
# For reliability, use Alchemy or Infura free-tier:
#   Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   Infura:  https://sepolia.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# --- Circle App Kit (Phase 3) ---
# Optional kit key from Circle Console (https://console.circle.com).
# Improves swap rate limits. Leave empty to use default limits.
NEXT_PUBLIC_CIRCLE_KIT_KEY=

# --- Rate Limiting (Phase 2) ---
# Max AI parse requests per minute per IP. Default: 10
RATE_LIMIT_MAX_REQUESTS=10
